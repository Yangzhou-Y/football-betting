# ===========================================
# 区块链网络 RPC URL
# ===========================================
# 以太坊测试网（Sepolia）
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# 以太坊主网
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# Conflux eSpace 测试网（chainId=71）
CONFLUX_TESTNET_RPC_URL=https://evmtestnet.confluxrpc.com

# Conflux eSpace 主网（chainId=1030）
CONFLUX_MAINNET_RPC_URL=https://evm.confluxrpc.com

# ===========================================
# 部署账户私钥（注意：绝不能上传到 GitHub！）
# ===========================================
PRIVATE_KEY=0x_your_private_key_here

# ===========================================
# USDT 代币合约地址（部署到真实链时必填）
# ===========================================
# Conflux eSpace 主网 USDT 地址（以实际查询为准）
# USDT_ADDRESS=0x...

# ===========================================
# 可选：Etherscan API Key（用于合约验证）
# ===========================================
ETHERSCAN_API_KEY=your_etherscan_api_key
